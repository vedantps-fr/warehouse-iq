{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build website",
      "type": "shell",
      "command": "node build.js",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "node tests/run-tests.js",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
